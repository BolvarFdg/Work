+def _error_count(content: str) -> Optional[int]:
+    """解析检测 Agent 输出 JSON 的 error_list 条数；解析失败返回 None（未知，调用方按不跳过处理）。"""
+    try:
+        data = json.loads(content)
+        return len(data.get("error_list") or [])
+    except (json.JSONDecodeError, TypeError, AttributeError):
+        return None
